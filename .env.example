# ══════════════════════════════════════════════════════════════════════════════
# SafeRelease — Environment Variables
# Copy this file to .env and fill in your real values.
# Never commit the filled .env to git — it is already in .gitignore.
# Docker Compose reads .env automatically on `docker-compose up`.
# ══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL — persistent scan history ──────────────────────────────────────
# Local dev (docker-compose):  Host=postgres;Port=5432;Database=saferelease;Username=postgres;Password=postgres
# Free cloud (Neon.tech):      postgresql://user:pass@ep-xxx.neon.tech/saferelease?sslmode=require
# Note: IBM Cloud Databases for PostgreSQL has no free tier — use Neon.tech for free cloud hosting.
DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=saferelease;Username=postgres;Password=postgres

# ── IBM Cloud (shared by C# API + Python sidecar) ─────────────────────────────
# Get from: cloud.ibm.com → Manage → Access (IAM) → API keys
IBM_CLOUD_APIKEY=your_ibm_cloud_api_key_here
# Get from: watsonx.ai → your project → Manage → General → Project ID
IBM_PROJECT_ID=your_watsonx_project_id_here

# ── Watson Natural Language Understanding (C# RiskEngineService) ──────────────
# Also used for: Emotion detection (anger/disgust/fear) — no extra key needed
# Get from: cloud.ibm.com → NLU service → Manage → Credentials
WATSON_API_KEY=your_watson_nlu_api_key_here
WATSON_URL=https://api.us-south.natural-language-understanding.watson.cloud.ibm.com

# ── Watson Speech to Text (C# SpeechToTextService) ────────────────────────────
# Get from: cloud.ibm.com → Speech to Text service → Manage → Credentials
STT_API_KEY=your_watson_stt_api_key_here
STT_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com

# ── Watson Text to Speech (C# TextToSpeechService) ────────────────────────────
# Get from: cloud.ibm.com → Text to Speech service → Manage → Credentials
TTS_API_KEY=your_watson_tts_api_key_here
TTS_URL=https://api.us-south.text-to-speech.watson.cloud.ibm.com

# ── Watson Speech to Text (Python sidecar voice_processor.py) ─────────────────
# Same service as STT above — Python sidecar uses the ibm-watson SDK with different var names
WATSON_STT_API_KEY=your_watson_stt_api_key_here
WATSON_STT_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com

# ── Watson Assistant (optional — results chatbot) ─────────────────────────────
# Embed ID from: Watson Assistant instance → Integrations → Web Chat → Embed snippet
# Free tier: 1,000 monthly active users (Lite plan). Leave blank to hide widget.
WATSON_ASSISTANT_INTEGRATION_ID=your_assistant_integration_id_here
WATSON_ASSISTANT_REGION=us-south
WATSON_ASSISTANT_SERVICE_INSTANCE_ID=your_service_instance_id_here

# ── Groq (Python sidecar LLM fallback) ────────────────────────────────────────
# Used when IBM watsonx.ai Granite is unavailable. Free tier available.
# Get from: console.groq.com → API Keys
GROQ_API_KEY=your_groq_api_key_here

# ── Google Gemini Vision (C# ImageDetectionService fallback, optional) ────────
# Only used if IBM Granite Vision fails. Leave blank to disable.
# Get from: aistudio.google.com → API keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

# ── FFmpeg path override (optional) ───────────────────────────────────────────
# Leave blank — auto-detected from /usr/bin/ffmpeg (installed in Dockerfile).
# Only set if you have a custom FFmpeg binary location.
FFMPEG_EXECUTABLE_PATH=
