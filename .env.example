# SafeRelease Environment Variables Example
# Copy this file to '.env' and fill in your actual keys.
# Docker Compose will automatically read the '.env' file when you run 'docker-compose up'

# Groq API Key (Fallback LLM)
GROQ_API_KEY=your_groq_api_key_here

# IBM Cloud API Keys (Primary Services for Python Sidecar)
IBM_CLOUD_APIKEY=your_ibm_api_key_here
IBM_PROJECT_ID=your_ibm_project_id_here

# Watson NLU API Keys (For C# Backend Risk Engine)
WATSON_API_KEY=your_watson_nlu_api_key_here
WATSON_URL=your_watson_nlu_url_here

# Watson Speech to Text Keys (For Voice & Video audio transcription — Python Sidecar)
# Create a free "Speech to Text" service instance at cloud.ibm.com/catalog/services/speech-to-text
WATSON_STT_API_KEY=your_watson_stt_api_key_here
WATSON_STT_URL=your_watson_stt_url_here
